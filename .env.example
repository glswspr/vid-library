# Copy this file to .env (gitignored) and fill in what you need.
#
# --- Client-side keys (NOT secret) -------------------------------------------
# Anything prefixed with VITE_ is inlined into the built JS bundle and is
# therefore public to every visitor. Only use keys you accept being read.
#
# Your own free TMDB key: https://www.themoviedb.org/settings/api
# Used to enrich search results, posters, ratings and episode air dates.
VITE_TMDB_API_KEY=
# Your own free OMDb key: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=
#
# Set to "false" to disable the server-side TMDB proxy and always call TMDB
# directly from the browser. Only needed for static-only hosts (Surge) that
# have no server — the app already falls back automatically.
VITE_TMDB_PROXY=
#
# --- Server-side keys (secret) ----------------------------------------------
# NOT prefixed with VITE_, so never reaches the browser bundle.
#
# TMDB key used by the api/tmdb.ts Vercel function. Set it in the Vercel
# dashboard (Project > Settings > Environment Variables) or in this file for
# local `vercel dev`. Keeping the key here means it is not shipped to visitors.
TMDB_API_KEY=
#
# --- Deploy secrets (local only) --------------------------------------------
# Vercel deploy hook token used by `npm run deploy:vercel`.
# Vercel dashboard > Project > Settings > Git > Deploy Hooks.
# NEVER commit this — package.json used to embed it, which exposed a
# production-deploy credential to anyone with repo access.
VERCEL_DEPLOY_HOOK=
