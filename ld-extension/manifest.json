{
  "manifest_version": 3,
  "name": "LD Habits Tracker",
  "version": "0.1.0",
  "description": "Times active tab per domain for the local Life Dashboard. Private, no network.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [{
    "resources": ["bridge.html"],
    "matches": ["<all_urls>"]
  }]
}