{
  "name": "vid-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/index.html', 'dist/200.html')\"",
    "deploy": "npm run build && npm run deploy:vercel && npm run deploy:surge",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "deploy:surge": "npx surge dist v1d.surge.sh",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev-server=http://localhost:5173",
    "desktop:test": "electron . --self-test"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^44.4.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  }
}
