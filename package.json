{
  "name": "vid-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/index.html', 'dist/200.html')\" && node scripts/copy-lite.cjs",
    "deploy": "npm run build && npm run deploy:vercel && npm run deploy:surge && npm run deploy:surge-lite && npm run deploy:surge-direct",
    "deploy:vercel": "curl -X POST \"https://api.vercel.com/v1/integrations/deploy/prj_m5NddXkFeGaiiaXv74Ro9KZVRQzz/39iL911coC\"",
    "deploy:surge": "npx surge dist v1d.surge.sh",
    "deploy:surge-lite": "npx surge dist/lite v2d.surge.sh",
    "deploy:surge-direct": "npx surge dist vid-native.surge.sh",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
